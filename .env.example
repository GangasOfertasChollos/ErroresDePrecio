# Credenciales de Telegram (https://my.telegram.org -> API development tools)
API_ID=
API_HASH=

# Canal que se escucha
TELEGRAM_CHANNEL=@GangasOfertasChollos

# ── Opcionales (valores por defecto entre parentesis) ──
# Maximo de ofertas del feed global, general.json, que es lo que se ve en la
# portada. El recorte se queda con las MAX_OFERTAS mas recientes. (100)
# MAX_OFERTAS=100

# Maximo de ofertas de cada seccion de categoria (30).
#
# Es menor que el general a proposito: las paginas de categoria son un
# escaparate de lo que acaba de bajar de precio, no un archivo historico, asi
# que interesa que se renueven rapido en lugar de acumular 100 ofertas donde 30
# ya se ven a la primera pagina.
# MAX_OFERTAS_CATEGORIA=30

# Mensajes del historico que se recuperan al arrancar, para no perder ofertas
# si el bot estuvo parado. 0 lo desactiva.
#
# Tiene que ser MAYOR que MAX_OFERTAS, y no por error: de cada mensaje leido
# solo se publica el que es publicable (con enlace, titulo y precio). De los
# ultimos 100 mensajes del canal 84 eran ofertas, asi que para llenar los 100
# huecos hay que leer algo mas de 100. El recorte normal se queda con las
# MAX_OFERTAS mas recientes. (130)
#
# La comparacion es contra MAX_OFERTAS porque el feed global es el que mas
# oferta necesita: es el unico que hay que leer bastante historial para llenar.
# Las secciones (MAX_OFERTAS_CATEGORIA=30) se llenan antes y les sobra.
# BACKFILL_LIMIT=130

# Al arrancar, borra todas las ofertas y todas las imagenes (data/ y
# data/images/) y las vuelve a construir con los ultimos
# BACKFILL_LIMIT mensajes del canal, en vez de añadirlos a lo que ya
# habia. Asi lo publicado es siempre el estado actual del canal y no se
# acumulan ofertas caducadas ni retoques a mano. El borrado se hace
# despues de leer el historial: si Telegram falla, se conserva lo que
# hubiera. (1)
# REINICIAR_CATALOGO=1

# Obtiene la miniatura de cada oferta con link unfurling de la pagina publica
# del mensaje en t.me. Se cachea en memoria. (1)
# USAR_UNFURL=1

# Segundos de espera al pedir la miniatura (15)
# TIMEOUT_UNFURL=15

# Publica data/ en git automaticamente tras cada oferta. Sin esto el bot
# escribe los JSON pero la web solo se actualiza con un git push manual.
# Requiere tener git instalado y el remoto configurado. (0 = desactivado)
# AUTO_PUBLICAR=0
# GIT_REMOTO=origin
# GIT_RAMA=main

# Regenera el HTML a partir de los JSON antes de subirlo (1 = activado).
# Las paginas de catalogo se sirven con las ofertas escritas dentro, asi que
# sin esto el repositorio queda con los JSON de una tanda y el HTML de la
# anterior, y el crawler no ve las ofertas nuevas. Se aplica dentro del mismo
# commit que los JSON. Ponerlo a 0 deja el bot como estaba: sube solo data/.
# REGENERAR_HTML=1

# Agrupa las subidas para no crear un commit por cada oferta. (60)
#
# El bot comprueba si toca subir cada PUBLICAR_CADA_SEGUNDOS aunque no entre
# ningun mensaje nuevo, de modo que una oferta que se queda sin subir por
# culpa del agrupado sale sola en el siguiente ciclo, sin depender de que el
# canal vuelva a escribir.
# PUBLICAR_CADA_SEGUNDOS=60

# Segundos que el bot aguanta antes de cerrar solo, haciendo el push final.
# 0 = no se para solo (Ctrl+C o SIGTERM lo paran igualmente, con el push
# hecho). Ponlo a un valor alto si lo lanzas como tarea programada, para que
# termine por si solo en vez de tener que matarlo.
# DURACION_SEGUNDOS=0

# ── Publicar en X (publicar_x.py) ──
# El script habla con la API interna de X, la misma que usa la web, con las
# cookies de una sesion del navegador. No hace falta la API de pago.
#
# Como se saca la cookie: abre x.com con la cuenta que publica, F12 >
# Application > Cookies > https://x.com, y copia el valor de "auth_token".
# El "ct0" se puede copiar tambien (es el token CSRF) o se deja vacio y el
# script se lo pide a X.
# AVISO: esta cookie es lo mismo que estar con la sesion iniciada. No la
# publiques ni la compartas.
# X_AUTH_TOKEN=
# X_CT0=

# La cuenta que publica. Se usa para los enlaces de los posts y para leer los
# ultimos posts con --verificar.
# X_USUARIO=mi_cuenta

# Por defecto el script se queda corriendo y publica una oferta en cada franja
# horaria, todos los dias. Si arranca cuando una franja ya ha pasado, la salta
# y sigue con la siguiente. Con --ahora publica de golpe las pendientes.
#
# Franjas: manana, mediodia, tarde y noche. (08:00,12:00,17:00,21:00)
# X_HORAS=08:00,12:00,17:00,21:00

# Zona horaria de las franjas. En Termux el reloj del sistema suele estar en
# UTC: sin esto, las 08:00 serian las 10:00 en Espana en verano. Si falta
# tzdata, el script avisa y usa la hora del sistema. (Europe/Madrid)
# X_ZONA=Europe/Madrid

# Si el script arranca justo despues de una franja, esa franja sigue contando
# durante estos segundos. Pasado el margen, se salta. (120)
# X_MARGEN_FRANJA=120

# Con --ahora: cuantas ofertas se publican de una vez y cuantos segundos se
# espera entre una y otra. X limita las publicaciones seguidas: con 90 s de
# pausa ya rechazaba la segunda con el error 226 ("parece automatica"), asi
# que el ritmo que funciona es de minutos. (5 y 600)
# X_MAX_TWEETS=5
# X_PAUSA_SEGUNDOS=600

# Si se adjunta la imagen de la oferta. Las imagenes van a upload.x.com y a
# veces fallan: si fallan, el post sale igual sin imagen. (1)
# X_CON_IMAGEN=1

# Que hacer cuando X dice que la cuenta se ha pasado de tweets y mensajes por
# el dia (error 344). Se espera estos segundos y se reintenta la misma oferta,
# hasta estas veces. La respuesta con el enlace se reintenta menos, para no
# bloquear la siguiente franja: si la cuota esta agotada, el post principal ya
# salio. (1800, 8 y 1)
# X_ESPERA_CUOTA=1800
# X_REINTENTOS_CUOTA=8
# X_REINTENTOS_CUOTA_RESPUESTA=1

# Que hacer cuando X dice que la peticion parece automatica (error 226). Suele
# ser que se acaba de publicar: se espera estos segundos y se reintenta la
# misma oferta, hasta estas veces. Se reintenta menos veces que la cuota
# porque repetir mucho tambien se ve mal. (900 y 3)
# X_ESPERA_AUTOMATIZACION=900
# X_REINTENTOS_AUTOMATIZACION=3

# Solo publica ofertas con id mayor que este. Sirve para no subir de golpe
# el historico entero la primera vez. (0 = todas)
# X_SOLO_ID_MIN=0

# Los hashtags que se anaden a cada post, mas uno segun la categoria.
# X_HASHTAGS=#Amazon #Chollos

# Un enlace fijo que se anade a la respuesta con los enlaces, despues del de
# la oferta. Vacio = solo el enlace de Amazon. (vacio)
# X_ENLACE_EXTRA=https://gangasofertas.com/general.html

# Los enlaces van en una respuesta al post, no en el post principal: X resta
# alcance a los posts que llevan enlaces. Con 0 vuelven al post principal.
# (1)
# X_ENLACE_RESPUESTA=1

# Segundos entre el post principal y la respuesta con el enlace. Dos posts
# seguidos pueden disparar el error 226. (30)
# X_PAUSA_RESPUESTA=30

# Texto de la respuesta con los enlaces. Campos: {intro} {enlaces} {url}
# {titulo} {precio}. Si no se define, se usa:
# 🔗 {intro}\n\n{enlaces}
# X_PLANTILLA_RESPUESTA=🔗 {intro}\n\n{enlaces}

# El texto del post, con los campos disponibles. Los saltos de linea se
# escriben como \n. Si no se define, se usa el de por defecto:
# precios -> pregunta -> titulo/descripcion -> hashtags -> enlaces.
# Con X_ENLACE_RESPUESTA=1, {enlaces} y {url} quedan vacios en el post
# principal: los enlaces van en la respuesta.
# Si usas una plantilla propia, no pongas URLs fijas aqui: el post principal
# debe quedar sin enlaces. Ponlas en X_PLANTILLA_RESPUESTA.
# X_PLANTILLA={precios}\n\n{pregunta}\n\n{titulo}\n\n{descripcion}\n\n{hashtags}\n\n{enlaces}

# Los ids de las operaciones de GraphQL, si se ponen a mano. El script los
# busca solo en el JavaScript de x.com y los cachea una semana, asi que
# normalmente no hace falta tocarlos. Se pueden poner varias separadas por
# comas: CreateTweet es la que usa la web de ahora y createTweetMutation la
# vieja, que X no trata igual (una responde 226 y la otra 344).
# X_QUERY_IDS=CreateTweet=wR5Z_lEibLvkew3tF9w-Sg,createTweetMutation=ewPB3lRszYIJIpDvJ8dLCQ
