# Credenciales de Telegram (https://my.telegram.org -> API development tools)
API_ID=
API_HASH=

# Canal que se escucha
TELEGRAM_CHANNEL=@GangasOfertasChollos

# ── Opcionales (valores por defecto entre parentesis) ──
# Maximo de ofertas del feed global, general.json, que es lo que se ve en la
# portada. El recorte se queda con las MAX_OFERTAS mas recientes. (100)
# MAX_OFERTAS=100

# Maximo de ofertas de cada seccion de categoria (30).
#
# Es menor que el general a proposito: las paginas de categoria son un
# escaparate de lo que acaba de bajar de precio, no un archivo historico, asi
# que interesa que se renueven rapido en lugar de acumular 100 ofertas donde 30
# ya se ven a la primera pagina.
# MAX_OFERTAS_CATEGORIA=30

# Mensajes del historico que se recuperan al arrancar, para no perder ofertas
# si el bot estuvo parado. 0 lo desactiva.
#
# Tiene que ser MAYOR que MAX_OFERTAS, y no por error: de cada mensaje leido
# solo se publica el que es publicable (con enlace, titulo y precio). De los
# ultimos 100 mensajes del canal 84 eran ofertas, asi que para llenar los 100
# huecos hay que leer algo mas de 100. El recorte normal se queda con las
# MAX_OFERTAS mas recientes. (130)
#
# La comparacion es contra MAX_OFERTAS porque el feed global es el que mas
# oferta necesita: es el unico que hay que leer bastante historial para llenar.
# Las secciones (MAX_OFERTAS_CATEGORIA=30) se llenan antes y les sobra.
# BACKFILL_LIMIT=130

# Al arrancar, borra todas las ofertas y todas las imagenes (data/ y
# data/images/) y las vuelve a construir con los ultimos
# BACKFILL_LIMIT mensajes del canal, en vez de añadirlos a lo que ya
# habia. Asi lo publicado es siempre el estado actual del canal y no se
# acumulan ofertas caducadas ni retoques a mano. El borrado se hace
# despues de leer el historial: si Telegram falla, se conserva lo que
# hubiera. (1)
# REINICIAR_CATALOGO=1

# Obtiene la miniatura de cada oferta con link unfurling de la pagina publica
# del mensaje en t.me. Se cachea en memoria. (1)
# USAR_UNFURL=1

# Segundos de espera al pedir la miniatura (15)
# TIMEOUT_UNFURL=15

# Publica data/ en git automaticamente tras cada oferta. Sin esto el bot
# escribe los JSON pero la web solo se actualiza con un git push manual.
# Requiere tener git instalado y el remoto configurado. (0 = desactivado)
# AUTO_PUBLICAR=0
# GIT_REMOTO=origin
# GIT_RAMA=main

# Regenera el HTML a partir de los JSON antes de subirlo (1 = activado).
# Las paginas de catalogo se sirven con las ofertas escritas dentro, asi que
# sin esto el repositorio queda con los JSON de una tanda y el HTML de la
# anterior, y el crawler no ve las ofertas nuevas. Se aplica dentro del mismo
# commit que los JSON. Ponerlo a 0 deja el bot como estaba: sube solo data/.
# REGENERAR_HTML=1

# Agrupa las subidas para no crear un commit por cada oferta. (60)
#
# El bot comprueba si toca subir cada PUBLICAR_CADA_SEGUNDOS aunque no entre
# ningun mensaje nuevo, de modo que una oferta que se queda sin subir por
# culpa del agrupado sale sola en el siguiente ciclo, sin depender de que el
# canal vuelva a escribir.
# PUBLICAR_CADA_SEGUNDOS=60

# Segundos que el bot aguanta antes de cerrar solo, haciendo el push final.
# 0 = no se para solo (Ctrl+C o SIGTERM lo paran igualmente, con el push
# hecho). Ponlo a un valor alto si lo lanzas como tarea programada, para que
# termine por si solo en vez de tener que matarlo.
# DURACION_SEGUNDOS=0
