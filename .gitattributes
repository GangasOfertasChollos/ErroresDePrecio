# Normalizacion de finales de linea.
#
# El repositorio se trabaja con CRLF en la raiz y con LF en la seccion
# BlackFriday. Sin esto, cada checkout mezcla los dos formatos y los diffs
# ensucian lineas enteras que no han cambiado de contenido.
#
# El orden importa: los patrones mas especificos van despues.

* text=auto

# Raiz del sitio: CRLF
*.html   text eol=crlf
*.css    text eol=crlf
*.js     text eol=crlf
*.py     text eol=crlf
*.xml    text eol=crlf
*.txt    text eol=crlf
*.md     text eol=crlf
*.json   text eol=crlf
*.svg    text eol=crlf

# Secciones BlackFriday y PrimeDays: LF (llego asi desde su origen y se mantiene)
BlackFriday/** text eol=lf
PrimeDays/**  text eol=lf

# Binarios: nunca se tocan
*.jpg    binary
*.jpeg   binary
*.png    binary
*.gif    binary
*.ico    binary
*.webp   binary
*.pdf    binary
*.woff   binary
*.woff2  binary
