*.session
*.session-journal
__pycache__/
.env

# Entorno virtual de Python
.venv/

# Logs del bot (se generan en la raiz del proyecto)
*.log

# Temporales de escritura atomica
*.json.tmp

# Artefactos de pruebas
repo_prueba/
_prueba_*/

# El bot no guarda imagenes en disco (el campo image es una URL), pero si algo
# las recreara, data/ debe seguir siendo solo JSON: cualquier binario ahi
# acabaria servido por GitHub Pages en rutas que el navegador no resuelve.
data/images/
data/**/*.jpg
data/**/*.jpeg
data/**/*.png
data/**/*.gif
data/**/*.webp
